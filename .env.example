# Copy to .env, or just run `npm run setup` and it writes this for you.
AI_PROVIDER=ollama            # ollama | lmstudio | openai
OLLAMA_MODEL=qwen2.5:3b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=
# OPENAI_API_KEY=             # never commit this file with a real key

# Running it for real (all optional)
# AI_LOG=info                 # off | error | info | debug   (logs/late.log, keys are hidden)
# AI_KEEP_HISTORY=on          # the chat is remembered after you quit (terminal and web)
# AI_PDF=on                   # read PDF files (setup asks; npm start adds the library)
# AI_RATE_LIMIT=30            # web UI: chat messages per minute (0 = no limit)
# AI_MAX_QUESTION_CHARS=8000

# Steadier web search (all optional; DuckDuckGo is the spare). Your search words are sent to the one you pick.
# AI_SEARCH_PROVIDER=auto     # auto | duckduckgo | brave | tavily | searxng
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_URL=http://localhost:8080

# Watching it
# AI_METRICS_TOKEN=           # turns on /api/metrics
# AI_ERROR_WEBHOOK=           # a Slack-style URL that hears about errors
